<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
  </head>
  <body>
    <h1>Welcome!</h1>
    <% if(user) {%>
    <p>logged in</p>
    <% if(!user.member) {%>
      <a href="/membership"><button>Become a member</button></a>
    <% } %>
    <form action="/logout" method="post">
      <button type="submit">Logout</button>
    </form>
    <% } else {%>
    <a href="/login"><button>Login</button></a>
    <a href="/signup"><button>Signup</button></a>

    <% } %>

    <% if(posts) { %>
      <div class="posts">
      <% posts.forEach(post => { %>
        <div class="post">
          <h2><%=post.title%></h2>
          <p><%=post.name%></p>
          <p><%=post.time%></p>
          <p><%=post.message%></p>
          <% if(user.admin){ %>
          <form action="/<%=post.id%>/delete-message" method="post">
            <button type="submit">Delete</button>
          </form>
          <% } %>
        </div>
      <% }) %>
    <% } %>
    <% if(user && user.member) {%>
    <a href="/create-message"><button>Create Post</button></a>
    <%}%>
  </body>
</html>
