<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
  </head>
  <body>
    <h1>Welcome!</h1>
    <% if(user) {%>
    <p>logged in</p>
    <form action="/logout" method="post">
      <button type="submit">Logout</button>
    </form>
    <% } else {%>
    <a href="/login"><button>Login</button></a>
    <a href="/signup"><button>Signup</button></a>

    <% } %>
  </body>
</html>
