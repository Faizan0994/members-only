<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Post</title>
  </head>
  <body>
    <h1>Create Post</h1>
    <% if (errors){%>
    <ul>
      <% errors.forEach(error => { %>
      <li><%= error.msg %></li>
      <% }) %>
    </ul>
    <% } %>
    <form action="/create-message" method="post">
      <label for="title"
        >Title:
        <input
          type="text"
          max="50"
          name="title"
          id="title"
          value="<%= title || ''%>"
          required
      /></label>
      <label for="message"
        >Message:
        <input
          type="text"
          max="200"
          name="message"
          id="message"
          value="<%= message || ''%>"
          required
      /></label>
      <button type="submit">Create</button>
    </form>
  </body>
</html>
